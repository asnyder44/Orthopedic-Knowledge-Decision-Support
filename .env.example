# Copy this file to .env and fill in what you need. Never commit .env.
# Everything is optional: with no settings the app runs with no AI and no API keys.

# ---------------------------------------------------------------- Hub, library and OrthoBot (orthoinfo)
# ORTHOINFO_DATASET_VERSION=v2026-10-26   # which data/processed/<version> to serve (default: newest)
# ORTHOINFO_METHOD=bm25                    # library search: bm25 | semantic | hybrid
# ORTHOINFO_RATE_LIMIT=30                  # OrthoBot questions per minute per visitor (0 = no limit)
# ORTHOINFO_TRUST_PROXY=1                  # set behind nginx / a PaaS router
# ORTHOINFO_CORS_ORIGINS=https://your-site-origin   # only if index.html is hosted on another origin
# ORTHOINFO_LOG_QUERIES=1                  # stores visitors' questions in data/logs/ (see README: privacy)
# ORTHOINFO_ROOT=/app                      # project folder (Docker sets this)
# ORTHOINFO_SECRET_KEY=                    # long random text; keeps KO Portal sign-ins across restarts
# ORTHOINFO_SECURE_COOKIES=1               # when the site is served over https

# ---------------------------------------------------------------- AI (one key turns on all AI features)
# Used by the KO Generator ("With AI"), the KO OrthoBot ("AI answer"), and, only if ORTHOBOT_AI=1,
# the public Hub OrthoBot's optional AI answer.

# Option A: Claude (Anthropic API, pay as you go). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Option B: OpenAI models (OpenAI API, pay as you go). A ChatGPT subscription does NOT include an API key.
# OPENAI_API_KEY=
# OKDS_OPENAI_MODEL=gpt-6.1-sol

# Option C: a free local model with Ollama (https://ollama.com):  ollama pull qwen3:8b   then set:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OKDS_OPENAI_MODEL=qwen3:8b

# OKDS_AI_PROVIDER=auto                    # auto (Claude if its key is set, else OpenAI) | claude | openai
# OKDS_MODEL=claude-sonnet-5-5             # Claude model (claude-opus-5-5 = stronger, about 2x the cost)
# OKDS_GENERATOR_EFFORT=medium             # Claude only: low | medium | high | xhigh | max
# OKDS_CHAT_EFFORT=medium

# Public AI answers on the Hub OrthoBot. Off unless set to 1 (every visitor's AI answer is billed to your key).
# ORTHOBOT_AI=1
# ORTHOBOT_AI_RATE_LIMIT=6                 # AI answers per minute per visitor on the Hub
# OKDS_AI_RATE_LIMIT=10                    # AI drafts / KO OrthoBot AI answers per minute per user

# ---------------------------------------------------------------- KO Portal (okds)
# Editing (save, import, delete, add topics, fetch pages, AI drafts) is allowed from this computer
# (http://127.0.0.1) without a password. Anyone else needs to sign in with this password:
# OKDS_EDIT_PASSWORD=
# OKDS_EDIT_LOCAL=0                        # require the password on this computer too
# OKDS_DATA_DIR=./data                     # where KOs, the topic list and source packs are stored
# OKDS_SEARCH=hybrid                       # KO search: keyword | semantic | hybrid
# OKDS_SEMANTIC=true                       # KO meaning search (needs: pip install -e ".[ko-semantic]")
# OKDS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OKDS_FETCH_RATE_LIMIT=20                 # page fetches per minute per user
# OKDS_ORTHOBOT_MIN_STATUS=draft           # OrthoBot answers from: draft (every KO) | team_checked (only reviewed KOs)

# ---------------------------------------------------------------- KO data pipeline (Pipeline / Review pages)
# OKDS_PIPELINE_KOS_PER_RUN=1              # Job 2 makes at most this many KOs per run (1 per day)
# OKDS_PIPELINE_TOPICS_PER_FETCH=3         # Job 1 searches for this many topics per run
# OKDS_PIPELINE_ARTICLES_PER_TOPIC=3       # most articles kept per topic
# OKDS_PIPELINE_MIN_ARTICLES=2             # articles a topic needs before a KO is made
# OKDS_PIPELINE_MAX_CHARS=15000            # longest article text kept
# OKDS_CONTACT_EMAIL=                      # an email sent to NCBI with API calls (NCBI asks for one; optional)
